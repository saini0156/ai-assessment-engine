# ===============================
# Git Ignore for Monorepo (AI Quiz)
# ===============================

# --- Python & Backend ---
backend/venv/
# --- Environment Files ---
.env
.env.*
backend/.env
backend/.env.*
**/__pycache__/
*.py[cod]
*$py.class
*.sqlite3

# --- Node.js & Next.js Frontend ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env.*.local
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE & System ---
.vscode/
.idea/
.agents/
.DS_Store
Thumbs.db
*.log
