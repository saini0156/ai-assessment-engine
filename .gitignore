# ===============================
# Git Ignore for Monorepo (AI Quiz)
# ===============================

# --- Python & Backend ---
backend/venv/
backend/.env
**/__pycache__/
*.py[cod]
*$py.class
*.sqlite3

# --- Node.js & Next.js Frontend ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE & System ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
